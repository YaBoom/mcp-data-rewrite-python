# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，切勿提交真实凭据
#   cp .env.example .env

# ========= 角色（决定这个 server 进程的权限）=========
# 可选：admin / manager / employee；非法值启动即报错
MCP_USER_ROLE=employee

# ========= MySQL =========
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=enterprise_db
DB_POOL_SIZE=10
DB_TIMEOUT_S=5

# ========= Redis =========
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=erp:

# ========= 内部 API =========
API_BASE_URL=http://localhost:3001
API_TIMEOUT_S=5
API_TOKEN=

# ========= 日志 =========
LOG_LEVEL=INFO